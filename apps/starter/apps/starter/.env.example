APP_NAME="Free Fire Info"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FREEFIRE_ENABLED=true
FREEFIRE_DEFAULT_REGION=BD
FREEFIRE_PROTOCOL=OB54
# Optional private credential override. Always set UID and PASSWORD together.
# Keep both keys present and blank to use the bundled fallback credentials.
# Exact-region and group scopes are also supported: IND, AMERICAS, VN, ID, TH, TW, GLOBAL.
FREEFIRE_DEFAULT_UID=
FREEFIRE_DEFAULT_PASSWORD=
FREEFIRE_ROUTES_ENABLED=true
FREEFIRE_PLAYER_CACHE_TTL=300
FREEFIRE_ASTCENC_BINARY=astcenc
FREEFIRE_MEDIA_ENABLED=true
FREEFIRE_MEDIA_CACHE_TTL=300
FREEFIRE_MEDIA_HTTP_CACHE_TTL=300
FREEFIRE_MEDIA_QUALITY=92
FREEFIRE_FONT_PATH=
FREEFIRE_MEDIA_TMP=
FREEFIRE_OFFICIAL_ASSET_BASES=
FREEFIRE_ASSET_CACHE_TTL=21600
FREEFIRE_COMPATIBILITY_ROUTES=true
