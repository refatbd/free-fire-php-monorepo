{
  "name": "refatbd/free-fire-php-monorepo",
  "description": "Development monorepo for the Free Fire PHP core, Laravel bridge and starter application.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/core",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "packages/laravel",
      "options": {
        "symlink": true
      }
    }
  ],
  "require-dev": {
    "refatbd/free-fire-php": "@dev",
    "phpunit/phpunit": "^11.0 || ^12.0",
    "refatbd/laravel-free-fire": "@dev",
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Refatbd\\LaravelFreeFire\\Tests\\": "packages/laravel/tests/"
    }
  },
  "scripts": {
    "proto:generate": "composer --working-dir=packages/core proto:generate",
    "proto:validate": "composer --working-dir=packages/core proto:validate",
    "test:smoke": "php tests/smoke.php",
    "test:docs": "php tests/documentation.php",
    "test": [
      "@proto:validate",
      "@test:smoke",
      "@test:docs",
      "@test:integration",
      "@test:generated",
      "@test:laravel"
    ],
    "lint": "php tools/lint.php",
    "test:integration": "php tests/integration_mock.php",
    "test:generated": "php tests/generated_proto.php",
    "test:laravel": "vendor/bin/phpunit -c packages/laravel/phpunit.xml"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
